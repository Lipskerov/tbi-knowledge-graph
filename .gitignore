# Secrets — auth password hash + session key (never commit)
.env
.env.*

# Service-account / credential keys — NEVER commit
*service-account*.json
*credentials*.json
genuine-flight-*.json
**/genuine-flight-*.json

# Internal context — confidential (investor/commercial positioning); do NOT publish
CLAUDE.md

# PDFs — copyright, not versioned
*.pdf

# PyVis bundled JS (regenerated at runtime)
lib/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.db-wal
*.db-shm
*.db.bak
*.bak

# kg2 build — raw downloads, intermediates and release outputs are regenerated by kg2/run_all.py.
# out/*/private holds UNPUBLISHED lab data: never commit.
kg2/raw/
kg2/interim/
kg2/out/
# kg2 gold-set sheets: abstract sentences (publisher copyright) + the blinded answer key.
kg2/curation/
# kg2 benchmark arms: regenerated byte-for-byte by kg2/bench/prepare.py
kg2/bench/data/
# kg2 LLM extractor input: the 400 gold-set sentences (abstract text)
kg2/bench/llm_items.tsv
# kg2 private layer: names of unpublished lab datasets — never commit
kg2/private_config.py
